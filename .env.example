# Hey Arro - example configuration.
#
# Copy this file to .env, then fill in your own values:
#
#     copy .env.example .env        (Windows)
#
# Notes
# - .env is gitignored. Never commit a real key.
# - Every setting here has a sensible default, so .env only needs the values you
#   want to change. Deleting a line restores its default.
# - A real environment variable always wins over this file, so a one-off run can
#   override anything without editing it:
#
#       set LLM_PROVIDER=mock && heyarro-env\Scripts\python.exe -m app.main
#
# - Every name also accepts a CLICKY_ prefixed alias (CLICKY_LLM_PROVIDER) from
#   the original prototype. Prefer the names below.


# --- the vision model (the only thing that needs your own key) --------------

# gemini = real answers from Google's vision model
# mock   = offline echo, no key and no network (useful to try the app out)
LLM_PROVIDER=gemini

# Your personal key from Google AI Studio (https://aistudio.google.com/apikey).
# This is the key that cannot be shared: everyone running Hey Arro needs their
# own. It is only ever read from this file or the environment - never logged.
GEMINI_API_KEY=your-personal-gemini-api-key

# Any vision-capable Gemini model your account can use.
GEMINI_MODEL=gemini-3.8-flash

# How long to wait for the model before reporting a failure, in seconds.
GEMINI_TIMEOUT_SECONDS=60

# Screenshots larger than this are rejected instead of being uploaded (8 MiB).
MAX_SCREENSHOT_BYTES=8388608


# --- speech to text (local, no key, no network after the first download) -----

# tiny | base | small | medium | large-v3 - bigger is slower but more accurate.
# The chosen model is downloaded once, the first time you run the app.
WHISPER_MODEL_SIZE=base

# cpu or cuda. int8 keeps a CPU run fast; use float16 with cuda.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Leave empty to detect the spoken language automatically, or pin one (en, de...).
WHISPER_LANGUAGE=


# --- screen capture ---------------------------------------------------------

# 0 = all monitors combined, 1 = primary monitor, 2+ = the other monitors.
SCREENSHOT_MONITOR=1

# Where captured screenshots are saved. Empty = %TEMP%\clicky-screenshots.
SCREENSHOT_DIR=


# --- screenshot refinement (unstructured) -----------------------------------

# The first step on every screenshot: it is saved in its own folder together with
# cropped images of the regions found on screen. Set false to skip it.
REFINEMENT_ENABLED=true

# Parent folder for those per-screenshot folders. Empty = ./screen-segments in the
# directory the app is started from.
REFINEMENT_DIR=

# hi_res (layout model, downloads once; finds the most regions) | ocr_only | auto
REFINEMENT_STRATEGY=hi_res

# Tesseract language codes, comma separated. Empty = unstructured's default.
REFINEMENT_LANGUAGES=

# Segments smaller than this many pixels are dropped as noise.
REFINEMENT_MIN_SEGMENT_PIXELS=16


# --- relevant segment selection (Gemini) --------------------------------------

# Once the question is transcribed, Gemini scores which segments of the screenshot
# matter for it and saves relevant_ss_manifest.json in the screenshot's folder.
# Needs REFINEMENT_ENABLED and GEMINI_API_KEY. Set false to skip it.
SEGMENT_SELECTION_ENABLED=true

# Empty = GEMINI_MODEL. A smaller, faster model is usually enough for this step.
SEGMENT_SELECTION_MODEL=

# Thinking tokens allowed before the answer: 0 = none (fastest), -1 = model default.
SEGMENT_SELECTION_THINKING_BUDGET=0


# --- response planning (Gemini) -----------------------------------------------

# After the segments are selected, Gemini plans how to respond to the question (the
# steps, where on screen each belongs, what to mark there) and saves
# response_plan.json in the screenshot's folder. It plans; it does not answer.
# Needs segment selection. Questions categorised as fallback are not planned.
RESPONSE_PLANNING_ENABLED=true

# Empty = GEMINI_MODEL.
RESPONSE_PLANNING_MODEL=

# Thinking tokens allowed before the plan: 0 = none (fastest), -1 = model default.
RESPONSE_PLANNING_THINKING_BUDGET=1024


# --- plan grounding (Gemini) --------------------------------------------------

# After the plan is written, Gemini finds where each step's target is on the screenshot
# (one small call per step, in parallel) and saves plan_pointers.json next to the plan.
# Needs response planning. Set false to skip it.
PLAN_GROUNDING_ENABLED=true

# Empty = GEMINI_MODEL.
PLAN_GROUNDING_MODEL=

# Thinking tokens allowed before the answer: 0 = none (fastest), -1 = model default.
PLAN_GROUNDING_THINKING_BUDGET=0


# --- final response (Gemini) --------------------------------------------------

# After the plan is grounded, Gemini writes the final response by following the plan:
# the sentences to say, each with the pointer of the plan step it belongs to, saved as
# final_response.json in the screenshot's folder. Nothing is drawn or spoken yet.
# Needs plan grounding. Set false to skip it.
FINAL_RESPONSE_ENABLED=true

# Empty = GEMINI_MODEL.
FINAL_RESPONSE_MODEL=

# Thinking tokens allowed before the answer: 0 = none (fastest), -1 = model default.
FINAL_RESPONSE_THINKING_BUDGET=0


# --- presenting the final response --------------------------------------------

# The status pill shows "Responding" for this many seconds, then each sentence is
# spoken while its mark is drawn on the screen.
RESPONDING_PAUSE_SECONDS=2

# Speak the sentences aloud. false = silent; the marks are still drawn, each for
# about its reading time.
TTS_ENABLED=true

# kokoro = natural local voice (Kokoro-82M on the CPU, offline after the first
# download); windows = the built-in Windows voice (pyttsx3). Kokoro falls back to
# the Windows voice when kokoro-onnx is not installed.
TTS_PROVIDER=kokoro

# Kokoro female voices:
#   American: af_heart (best), af_bella
#   British:  bf_emma (best), bf_isabella
#   Indian:   hf_alpha, hf_beta
KOKORO_VOICE=af_heart

# 1.0 = natural speed; 0.8 slower, 1.2 faster.
KOKORO_SPEED=1.0

# Pronunciation: en-us or en-gb. Empty = from the voice.
KOKORO_LANG=

# Folder for kokoro-v1.0.onnx and voices-v1.0.bin. Empty = tts_model/ in the project.
# Missing files are downloaded here once (about 340 MB).
KOKORO_MODEL_DIR=

# Windows voice only: speaking speed in words per minute. Empty = its own speed.
TTS_RATE_WPM=

# Windows voice only: 0.0 - 1.0. Empty = unchanged.
TTS_VOLUME=

# Windows voice only: a SAPI voice id. Empty = the default Windows voice.
TTS_VOICE_ID=

# Draw each sentence's mark (point, circle, underline, arrow, highlight) on screen.
OVERLAY_ENABLED=true

# The glass status pill at the top of the screen (Listening, Transcribing, ...).
STATUS_INDICATOR_ENABLED=true


# --- mock provider ----------------------------------------------------------

# Artificial delay for LLM_PROVIDER=mock, so an offline run still takes a
# realistic amount of time.
MOCK_LLM_DELAY_SECONDS=0.4


# No other secrets are required: the pipeline needs one model key, and everything
# else runs locally.
