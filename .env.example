# Hey Arro - example configuration.
#
# Copy this file to .env, then fill in your own values:
#
#     copy .env.example .env        (Windows)
#
# Notes
# - .env is gitignored. Never commit a real key.
# - Every setting here has a sensible default, so .env only needs the values you
#   want to change. Deleting a line restores its default.
# - A real environment variable always wins over this file, so a one-off run can
#   override anything without editing it:
#
#       set LLM_PROVIDER=mock && heyarro-env\Scripts\python.exe -m app.main
#
# - Every name also accepts a CLICKY_ prefixed alias (CLICKY_LLM_PROVIDER) from
#   the original prototype. Prefer the names below.


# --- the vision model (the only thing that needs your own key) --------------

# gemini = real answers from Google's vision model
# mock   = offline echo, no key and no network (useful to try the app out)
LLM_PROVIDER=gemini

# Your personal key from Google AI Studio (https://aistudio.google.com/apikey).
# This is the key that cannot be shared: everyone running Hey Arro needs their
# own. It is only ever read from this file or the environment - never logged.
GEMINI_API_KEY=your-personal-gemini-api-key

# Any vision-capable Gemini model your account can use.
GEMINI_MODEL=gemini-3.8-flash

# How long to wait for the model before reporting a failure, in seconds.
GEMINI_TIMEOUT_SECONDS=60

# Screenshots larger than this are rejected instead of being uploaded (8 MiB).
MAX_SCREENSHOT_BYTES=8388608


# --- speech to text (local, no key, no network after the first download) -----

# tiny | base | small | medium | large-v3 - bigger is slower but more accurate.
# The chosen model is downloaded once, the first time you run the app.
WHISPER_MODEL_SIZE=base

# cpu or cuda. int8 keeps a CPU run fast; use float16 with cuda.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Leave empty to detect the spoken language automatically, or pin one (en, de...).
WHISPER_LANGUAGE=


# --- screen capture ---------------------------------------------------------

# 0 = all monitors combined, 1 = primary monitor, 2+ = the other monitors.
SCREENSHOT_MONITOR=1

# Where captured screenshots are saved. Empty = %TEMP%\clicky-screenshots.
SCREENSHOT_DIR=


# --- timing (how long things stay on screen) --------------------------------

# How long the transcript and the answer stay in the bubble next to the cursor,
# in milliseconds. Raise this if answers are longer than you can read in 4s.
TRANSCRIPT_DISPLAY_MS=4000

# How long the RESPONDING state lasts before returning to idle.
RESPONDING_HOLD_MS=2500

# How long an error stays visible before returning to idle.
ERROR_HOLD_MS=1200


# --- mock provider ----------------------------------------------------------

# Artificial delay for LLM_PROVIDER=mock, so the states are visible while testing.
MOCK_LLM_DELAY_SECONDS=0.4


# No other secrets are required: the answer pipeline needs one model key, and
# everything else runs locally.
